---
import { NAV } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="site-logo" href="/">~/ivon.dev</a>
		<nav aria-label="Main">
			<ul class="site-nav">
				{
					NAV.map((item) => (
						<li class:list={{ 'hide-on-phones': 'hideOnPhones' in item }}>
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
				<li class="hide-on-phones"><a class="button button--small" href="/#contact">start a project</a></li>
			</ul>
		</nav>
	</div>
</header>
